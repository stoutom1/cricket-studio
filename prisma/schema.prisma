generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                           @id @default(uuid())
  email                        String                           @unique
  name                         String?
  password                     String
  ownedLeagues                 League[]                         @relation("PrimaryLeagueOwner")
  backupOwnedLeagues           League[]                         @relation("BackupLeagueOwner")
  leagueMemberships            LeagueMember[]
  leagueRegistrations          LeagueRegistration[]
  activeLeagueId               Int?
  activeMatchId                Int?
  resetToken                   String?
  resetTokenExpiry             DateTime?
  createdAt                    DateTime                         @default(now())
  leagueFollowers              LeagueFollower[]
  lastLoginAt                  DateTime?
  lastSeenAt                   DateTime?
  loginHistory                 LoginHistory[]
  birthdaysCreated             LeagueBirthday[]                 @relation("BirthdayCreatedBy")
  birthdaysUpdated             LeagueBirthday[]                 @relation("BirthdayUpdatedBy")
  pushDevices                  PushDevice[]
  birthdayPreferences          BirthdayNotificationPreference[]
  birthdayReminderRecipients   BirthdayReminderLog[]            @relation("BirthdayReminderRecipient")
  birthdayRemindersShared      BirthdayReminderLog[]            @relation("BirthdayReminderSharedBy")
  webPushSubscriptions         WebPushSubscription[]
  assignedKitResponsibilities  KitAssignment[]                  @relation("KitAssignmentAssignedBy")
  pickupRecordedKitAssignments KitAssignment[]                  @relation("KitAssignmentPickupRecordedBy")
  smsPhoneNumber               String?
  smsOptIn                     Boolean                          @default(false)
  smsOptInAt                   DateTime?
  smsOptOutAt                  DateTime?
  smsConsentSource             String?
  smsConsentIp                 String?
  smsConsentUserAgent          String?
  smsConsentText               String?
  smsConsentVersion            String?
  leagueResourcesCreated       LeagueResource[]
  leagueResourceReactions      LeagueResourceReaction[]
  leagueResourceFavorites      LeagueResourceFavorite[]
  leagueResourceCollections    LeagueResourceCollection[]
}

model Team {
  id                    Int                 @id @default(autoincrement())
  name                  String
  createdAt             DateTime            @default(now())
  battingFirstMatches   Match[]             @relation("BattingFirstTeam")
  matchesA              Match[]             @relation("TeamA")
  matchesB              Match[]             @relation("TeamB")
  players               Player[]
  leagueId              Int
  league                League              @relation(fields: [leagueId], references: [id])
  matchKitPlayers       MatchKitPlayer[]
  kitRotationMembers    KitRotationMember[]
  kitAssignments        KitAssignment[]
  kitReminderLogs       KitReminderLog[]
  defaultCaptainId      Int?
  defaultViceCaptainId  Int?
  defaultWicketKeeperId Int?
  defaultCaptain        Player?             @relation("TeamDefaultCaptain", fields: [defaultCaptainId], references: [id], onDelete: SetNull)
  defaultViceCaptain    Player?             @relation("TeamDefaultViceCaptain", fields: [defaultViceCaptainId], references: [id], onDelete: SetNull)
  defaultWicketKeeper   Player?             @relation("TeamDefaultWicketKeeper", fields: [defaultWicketKeeperId], references: [id], onDelete: SetNull)

  @@unique([leagueId, name])
}

model Player {
  id                          Int                 @id @default(autoincrement())
  name                        String
  teamId                      Int
  createdAt                   DateTime            @default(now())
  bowlerBalls                 Ball[]              @relation("Bowler")
  dismissedBalls              Ball[]              @relation("DismissedPlayer")
  newBatterBalls              Ball[]              @relation("NewBatter")
  nonStrikerBalls             Ball[]              @relation("NonStriker")
  strikerBalls                Ball[]              @relation("Striker")
  team                        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  leagueBirthdays             LeagueBirthday[]
  whatsappNumber              String?
  whatsappOptIn               Boolean             @default(false)
  smsOptIn                    Boolean             @default(false)
  smsOptInAt                  DateTime?
  smsOptOutAt                 DateTime?
  smsOptInSource              String?
  smsOptInIpAddress           String?
  smsOptInUserAgent           String?
  matchKitPlayers             MatchKitPlayer[]
  kitRotationMembers          KitRotationMember[]
  defaultCaptainForTeams      Team[]              @relation("TeamDefaultCaptain")
  defaultViceCaptainForTeams  Team[]              @relation("TeamDefaultViceCaptain")
  defaultWicketKeeperForTeams Team[]              @relation("TeamDefaultWicketKeeper")

  @@unique([teamId, name])
  @@index([teamId])
}

model Match {
  id                    Int                  @id @default(autoincrement())
  shareCode             String?              @unique
  teamAId               Int
  teamBId               Int
  battingFirstTeamId    Int?
  oversPerInnings       Int
  powerplayOversInnings Int                  @default(0)
  status                String               @default("in_progress")
  createdAt             DateTime             @default(now())
  scheduledAt           DateTime?
  statusText            String?              @default("LIVE")
  maxOversPerBowler     Int?
  maxWicketsPerInnings  Int?
  balls                 Ball[]
  battingFirstTeam      Team?                @relation("BattingFirstTeam", fields: [battingFirstTeamId], references: [id])
  teamA                 Team                 @relation("TeamA", fields: [teamAId], references: [id])
  teamB                 Team                 @relation("TeamB", fields: [teamBId], references: [id])
  state                 MatchState?
  leagueId              Int?
  league                League?              @relation(fields: [leagueId], references: [id])
  events                MatchEvent[]
  aiAnalysis            String?
  aiAnalysisAt          DateTime?
  seriesId              Int?
  series                Series?              @relation(fields: [seriesId], references: [id])
  innings1EndedManually Boolean              @default(false)
  teamACaptainId        Int?
  teamBCaptainId        Int?
  teamAViceCaptainId    Int?
  teamBViceCaptainId    Int?
  teamAWicketKeeperId   Int?
  teamBWicketKeeperId   Int?
  wicketKeeperChanges   WicketKeeperChange[]
  startedAt             DateTime?
  endedAt               DateTime?
  lockedAt              DateTime?
  matchKitPlayers       MatchKitPlayer[]
  kitAssignments        KitAssignment[]
  kitReminderLogs       KitReminderLog[]
  leagueKitEvents       LeagueKitEvent[]
}

model Ball {
  id                 Int      @id @default(autoincrement())
  matchId            Int
  inningsNo          Int
  sequence           Int
  overNo             Int
  ballInOver         Int
  legalDelivery      Boolean
  strikerId          Int?
  nonStrikerId       Int?
  bowlerId           Int?
  dismissedPlayerId  Int?
  newBatterId        Int?
  runsOffBat         Int      @default(0)
  extras             Int      @default(0)
  extraType          String   @default("NONE")
  totalRuns          Int      @default(0)
  isWicket           Int      @default(0)
  wicketType         String   @default("NONE")
  isPowerPlay        Boolean  @default(false)
  note               String?
  createdAt          DateTime @default(now())
  bowler             Player?  @relation("Bowler", fields: [bowlerId], references: [id])
  dismissedPlayer    Player?  @relation("DismissedPlayer", fields: [dismissedPlayerId], references: [id])
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  newBatter          Player?  @relation("NewBatter", fields: [newBatterId], references: [id])
  nonStriker         Player?  @relation("NonStriker", fields: [nonStrikerId], references: [id])
  striker            Player?  @relation("Striker", fields: [strikerId], references: [id])
  fielderId          Int?
  assistantFielderId Int?
  wicketNote         String?

  // Offline-scoring idempotency/audit metadata.
  // Existing online balls keep these fields null.
  clientEventId   String?   @unique
  clientDeviceId  String?
  clientCreatedAt DateTime?

  @@unique([matchId, inningsNo, sequence])
  @@index([matchId, inningsNo, sequence])
  @@index([clientDeviceId])
}

model MatchState {
  matchId      Int   @id
  inningsNo    Int
  strikerId    Int?
  nonStrikerId Int?
  bowlerId     Int?
  match        Match @relation(fields: [matchId], references: [id])
}

model League {
  id                           Int                              @id @default(autoincrement())
  name                         String                           @unique
  createdAt                    DateTime                         @default(now())
  ownerId                      String?
  owner                        User?                            @relation("PrimaryLeagueOwner", fields: [ownerId], references: [id])
  backupOwnerId                String?
  backupOwner                  User?                            @relation("BackupLeagueOwner", fields: [backupOwnerId], references: [id], onDelete: SetNull)
  teams                        Team[]
  registrations                LeagueRegistration[]
  members                      LeagueMember[]
  invites                      LeagueInvite[]
  matches                      Match[]
  visibility                   String                           @default("PRIVATE")
  slug                         String?                          @unique
  series                       Series[]
  leagueFollowers              LeagueFollower[]
  birthdays                    LeagueBirthday[]
  birthdayPreferences          BirthdayNotificationPreference[]
  birthdayReminderLogs         BirthdayReminderLog[]
  whatsappNotificationsEnabled Boolean                          @default(false)
  ownerWhatsAppNumber          String?
  backupOwnerWhatsAppNumber    String?
  matchKitPlayers              MatchKitPlayer[]
  kitRotationMembers           KitRotationMember[]
  kitAssignments               KitAssignment[]
  kitRotationMode              KitRotationMode                  @default(TEAM)
  timeZone                     String                           @default("America/Los_Angeles")
  kitReminderLogs              KitReminderLog[]
  leagueKit                    LeagueKit?
  leagueKitEvents              LeagueKitEvent[]
  resources                    LeagueResource[]
  resourceCollections          LeagueResourceCollection[]

  @@index([backupOwnerId])
}

model LeagueRegistration {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  leagueId  Int
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  league League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@unique([leagueId, userId])
}

model LeagueMember {
  id Int @id @default(autoincrement())

  userId   String
  leagueId Int

  joinedAt DateTime @default(now())

  role String @default("VIEWER")

  // Navigation
  canViewDashboard  Boolean @default(true)
  canViewManagement Boolean @default(false)
  canViewMatches    Boolean @default(true)
  canViewScoring    Boolean @default(false)
  canViewStats      Boolean @default(true)

  // League
  canCreateLeague      Boolean @default(false)
  canEditLeague        Boolean @default(false)
  canDeleteLeague      Boolean @default(false)
  canManageMembers     Boolean @default(false)
  canManagePermissions Boolean @default(false)

  // Teams
  canCreateTeam Boolean @default(false)
  canEditTeam   Boolean @default(false)
  canDeleteTeam Boolean @default(false)

  // Players
  canCreatePlayer Boolean @default(false)
  canEditPlayer   Boolean @default(false)
  canDeletePlayer Boolean @default(false)

  // Matches
  canCreateMatch  Boolean @default(false)
  canEditMatch    Boolean @default(false)
  canDeleteMatch  Boolean @default(false)
  canEndMatch     Boolean @default(false)
  canAbandonMatch Boolean @default(false)
  canLockMatch    Boolean @default(false)

  // Scoring
  canScoreMatch   Boolean @default(false)
  canEditScore    Boolean @default(false)
  canUndoBall     Boolean @default(false)
  canSwapStrike   Boolean @default(false)
  canRetirePlayer Boolean @default(false)

  // Statistics
  canExportStats Boolean @default(false)

  // Admin
  canViewAuditLogs Boolean @default(false)

  // Polling and Team Splits
  canUseTeamBuilder         Boolean @default(false)
  canCreateAvailabilityPoll Boolean @default(false)

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, leagueId])
}

model LeagueInvite {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  leagueId  Int
  league    League   @relation(fields: [leagueId], references: [id])
  createdAt DateTime @default(now())
}

model MatchEvent {
  id Int @id @default(autoincrement())

  matchId   Int
  inningsNo Int

  eventType String

  playerId      Int?
  replacementId Int?

  strikerId    Int?
  nonStrikerId Int?

  note String?

  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, inningsNo])
}

model Series {
  id          Int      @id @default(autoincrement())
  leagueId    Int
  name        String
  year        Int
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  league  League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  matches Match[]
}

model CorrectionLog {
  id               Int       @id @default(autoincrement())
  matchId          Int
  type             String
  correctionBallId Int?
  payload          Json?
  beforeBalls      Json?
  createdAt        DateTime  @default(now())
  revertedAt       DateTime?

  correctionType  String? @default("RETIRED_HURT")
  correctionLabel String?
  reason          String?

  beforeJson Json?
  afterJson  Json?

  correctedById    Int?
  correctedByName  String?
  correctedByEmail String?
}

model WicketKeeperChange {
  id            Int      @id @default(autoincrement())
  matchId       Int
  inningsNo     Int
  afterSequence Int      @default(0)
  teamId        Int
  oldKeeperId   Int?
  newKeeperId   Int
  note          String?
  createdAt     DateTime @default(now())
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model LeagueFollower {
  id        Int      @id @default(autoincrement())
  userId    String
  leagueId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId])
}

model AuditLog {
  id Int @id @default(autoincrement())

  action     String
  entityType String
  entityId   Int?

  leagueId Int?
  matchId  Int?
  teamId   Int?
  playerId Int?

  actorUserId Int?
  actorName   String?
  actorEmail  String?

  description String?
  beforeData  Json?
  afterData   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([leagueId])
  @@index([matchId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model LoginHistory {
  id Int @id @default(autoincrement())

  userId String
  email  String
  name   String?

  loginAt DateTime @default(now())

  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([loginAt])
  @@index([userId])
  @@index([email])
}

model TeamBalanceVote {
  id        Int      @id @default(autoincrement())
  matchId   Int
  voterName String?
  vote      String // FAIR, UNFAIR
  comment   String?
  createdAt DateTime @default(now())
}

model TeamBalanceSuggestion {
  id                Int      @id @default(autoincrement())
  matchId           Int
  fromTeamAPlayerId Int
  fromTeamBPlayerId Int
  reason            String?
  createdAt         DateTime @default(now())
}

model TeamAvailabilityPoll {
  id            Int                        @id @default(autoincrement())
  token         String                     @unique
  leagueId      Int?
  title         String
  matchText     String?
  startTime     DateTime?
  status        String                     @default("OPEN") // OPEN, CLOSED
  createdAt     DateTime                   @default(now())
  options       TeamAvailabilityOption[]
  responses     TeamAvailabilityResponse[]
  sourceTeamIds String?
}

model TeamAvailabilityOption {
  id        Int       @id @default(autoincrement())
  pollId    Int
  label     String // Friday, Saturday, Sunday
  startTime DateTime?
  sortOrder Int       @default(0)

  poll      TeamAvailabilityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses TeamAvailabilityResponse[]
}

model TeamAvailabilityResponse {
  id          Int      @id @default(autoincrement())
  pollId      Int
  optionId    Int
  playerKey   String
  playerName  String
  response    String // YES, MAYBE, NO
  displayName String?
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  poll   TeamAvailabilityPoll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option TeamAvailabilityOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, playerKey])
}

model MatchCorrection {
  id Int @id @default(autoincrement())

  matchId  Int
  leagueId Int?

  correctionType  String
  correctionLabel String?

  beforeJson Json
  afterJson  Json

  reason String?

  correctedById    Int?
  correctedByName  String?
  correctedByEmail String?

  rolledBackAt   DateTime?
  rolledBackById Int?

  createdAt DateTime @default(now())

  @@index([matchId])
  @@index([leagueId])
  @@index([correctionType])
  @@index([createdAt])
}

enum BirthdayReminderType {
  DAY_BEFORE
  BIRTHDAY_TODAY
  WEB_PUSH
  WHATSAPP
  OWNER_SMS
  PLAYER_WHATSAPP
}

enum BirthdayReminderStatus {
  PENDING
  SENT
  FAILED
  SHARED
}

model LeagueBirthday {
  id         Int     @id @default(autoincrement())
  leagueId   Int
  playerId   Int
  name       String
  birthMonth Int
  birthDay   Int
  notes      String?
  isActive   Boolean @default(true)

  createdById String
  updatedById String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  whatsappNumber    String?
  whatsappOptIn     Boolean   @default(false)
  smsOptIn          Boolean   @default(false)
  smsOptInAt        DateTime?
  smsOptOutAt       DateTime?
  smsOptInSource    String?
  smsOptInIpAddress String?
  smsOptInUserAgent String?

  league    League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdBy User   @relation("BirthdayCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?  @relation("BirthdayUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  reminders BirthdayReminderLog[]
  player    Player                @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([leagueId, playerId])
  @@index([leagueId])
  @@index([leagueId, birthMonth, birthDay])
  @@index([leagueId, isActive])
  @@index([playerId])
}

model BirthdayNotificationPreference {
  id       Int    @id @default(autoincrement())
  userId   String
  leagueId Int

  enabled          Boolean @default(true)
  notifyDayBefore  Boolean @default(true)
  notifyOnBirthday Boolean @default(true)
  reminderHour     Int     @default(8)
  timeZone         String  @default("America/Los_Angeles")

  emailFallbackEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId])
  @@index([leagueId, enabled])
}

model PushDevice {
  id         Int      @id @default(autoincrement())
  userId     String
  token      String   @unique
  platform   String
  deviceName String?
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model BirthdayReminderLog {
  id              Int                    @id @default(autoincrement())
  birthdayId      Int
  leagueId        Int
  recipientUserId String
  birthdayYear    Int
  reminderType    BirthdayReminderType
  status          BirthdayReminderStatus @default(PENDING)

  notificationTitle String?
  notificationBody  String?

  recipientPhone     String?
  providerMessageId  String?
  providerStatus     String?
  providerResponse   Json?
  retryCount         Int       @default(0)
  nextRetryAt        DateTime?
  lastAttemptAt      DateTime?
  callbackExpectedAt DateTime?
  callbackReceivedAt DateTime?
  lastCallbackAt     DateTime?
  lastErrorCode      String?
  errorMessage       String?
  sentAt             DateTime?
  sharedAt           DateTime?
  sharedById         String?

  fallbackSmsBody        String?
  fallbackSmsAllowed     Boolean   @default(false)
  fallbackSmsStatus      String?
  fallbackSmsMessageId   String?
  fallbackSmsAttemptedAt DateTime?
  fallbackSmsQueuedAt    DateTime?
  fallbackSmsError       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  birthday  LeagueBirthday @relation(fields: [birthdayId], references: [id], onDelete: Cascade)
  league    League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  recipient User           @relation("BirthdayReminderRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  sharedBy  User?          @relation("BirthdayReminderSharedBy", fields: [sharedById], references: [id], onDelete: SetNull)

  @@unique([birthdayId, recipientUserId, birthdayYear, reminderType])
  @@index([leagueId, birthdayYear])
  @@index([recipientUserId, status])
}

model WebPushSubscription {
  id Int @id @default(autoincrement())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  expirationTime BigInt?

  userAgent  String?
  deviceName String?

  isActive Boolean @default(true)

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

enum KitAssignmentStatus {
  SUGGESTED
  ASSIGNED
  CONFIRMED
  DECLINED
  COMPLETED
  MISSED
  CANCELLED
}

enum KitReminderRecipientType {
  PLAYER
  ASSIGNED_CARRIER
  CURRENT_HOLDER
  CAPTAIN
  TEAM_MANAGER
  SCORER
  LEAGUE_OWNER
}

enum KitRotationMode {
  TEAM
  LEAGUE_PLAYER
}

enum KitPickupStatus {
  PENDING
  TOOK_KIT
  DID_NOT_TAKE_KIT
}

enum KitReminderType {
  DAY_BEFORE
  TWO_HOURS_BEFORE
  ASSIGNMENT_CHANGED
}

enum KitReminderChannel {
  WHATSAPP
  PUSH
}

enum KitReminderStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

model MatchKitPlayer {
  id Int @id @default(autoincrement())

  matchId  Int
  leagueId Int
  teamId   Int

  playerId Int?

  displayName    String
  normalizedName String

  whatsappNumber String?
  whatsappOptIn  Boolean @default(false)

  source      String  @default("SCREENSHOT")
  isConfirmed Boolean @default(false)
  isEligible  Boolean @default(true)
  sortOrder   Int     @default(0)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  /**
   * Assignments where this player was
   * originally selected as the kit carrier.
   */
  assignments KitAssignment[] @relation("AssignedKitMatchPlayer")

  /**
   * Assignments where this player was later
   * recorded as the person who actually
   * took the kit.
   */
  actualKitAssignments KitAssignment[] @relation("ActualKitCarrierPlayer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, teamId, normalizedName])
  @@index([matchId, teamId])
  @@index([leagueId, normalizedName])
}

model KitRotationMember {
  id Int @id @default(autoincrement())

  leagueId Int

  // TEAM:<teamId> for ordinary leagues
  // LEAGUE:<leagueId> for Surprise Cricket League
  rotationKey String

  // Present for TEAM mode; null for LEAGUE_PLAYER mode
  teamId Int?

  playerId Int?

  displayName    String
  normalizedName String

  whatsappNumber String?
  whatsappOptIn  Boolean @default(false)

  completedCount  Int       @default(0)
  lastCompletedAt DateTime?
  lastAssignedAt  DateTime?

  isActive Boolean @default(true)

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  assignments KitAssignment[] @relation("AssignedKitRotationMember")

  actualKitAssignments KitAssignment[] @relation("ActualKitCarrier")

  currentHolderForLeagueKits  LeagueKit[] @relation("LeagueKitCurrentHolder")
  previousHolderForLeagueKits LeagueKit[] @relation("LeagueKitPreviousHolder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rotationKey, normalizedName])
  @@index([leagueId, rotationKey])
  @@index([rotationKey, completedCount, lastCompletedAt])
}

enum LeagueKitStatus {
  UNASSIGNED
  WITH_HOLDER
  AWAITING_COORDINATION
  HANDOVER_CONFIRMED
  AT_VENUE
}

enum LeagueKitHandoverStatus {
  NOT_REQUIRED
  PENDING
  COORDINATED
  HANDED_OVER
}

/**
 * One physical kit owned and tracked at league level.
 * The current holder is the person presently recorded as having
 * custody of the kit. The previous holder is retained for display
 * and audit context after custody changes. Upcoming responsibility
 * remains in KitAssignment so the assigned and actual carriers are
 * never overwritten.
 */
model LeagueKit {
  id       Int @id @default(autoincrement())
  leagueId Int @unique

  name String @default("League Kit")

  status         LeagueKitStatus         @default(UNASSIGNED)
  handoverStatus LeagueKitHandoverStatus @default(NOT_REQUIRED)

  currentHolderRotationMemberId  Int?
  previousHolderRotationMemberId Int?

  holderConfirmedAt   DateTime?
  handoverConfirmedAt DateTime?
  venueConfirmedAt    DateTime?

  notes String?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  currentHolderRotationMember  KitRotationMember? @relation("LeagueKitCurrentHolder", fields: [currentHolderRotationMemberId], references: [id], onDelete: SetNull)
  previousHolderRotationMember KitRotationMember? @relation("LeagueKitPreviousHolder", fields: [previousHolderRotationMemberId], references: [id], onDelete: SetNull)

  assignments KitAssignment[]
  events      LeagueKitEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentHolderRotationMemberId])
  @@index([previousHolderRotationMemberId])
  @@index([status, handoverStatus])
}

enum LeagueKitEventType {
  KIT_CREATED
  ASSIGNMENT_CREATED
  ASSIGNMENT_CHANGED
  COORDINATION_CONFIRMED
  HANDOVER_CONFIRMED
  VENUE_CONFIRMED
  STATUS_RESET
  CUSTODY_TRANSFERRED
  CUSTODY_NOT_TRANSFERRED
}

model LeagueKitEvent {
  id Int @id @default(autoincrement())

  leagueKitId  Int
  leagueId     Int
  matchId      Int?
  assignmentId Int?

  eventType LeagueKitEventType

  fromHolderRotationMemberId Int?
  toHolderRotationMemberId   Int?

  fromHolderName String?
  toHolderName   String?

  description String?
  metadata    Json?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  leagueKit  LeagueKit      @relation(fields: [leagueKitId], references: [id], onDelete: Cascade)
  league     League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  match      Match?         @relation(fields: [matchId], references: [id], onDelete: SetNull)
  assignment KitAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([leagueKitId, occurredAt])
  @@index([leagueId, occurredAt])
  @@index([matchId])
  @@index([assignmentId])
  @@index([eventType, occurredAt])
}

model KitAssignment {
  id Int @id @default(autoincrement())

  leagueId Int
  matchId  Int
  teamId   Int

  // Populated for leagues that use one shared league kit.
  // Null preserves the existing one-kit-per-team workflow.
  leagueKitId Int?

  rotationKey String

  /**
   * Originally assigned kit carrier.
   */
  rotationMemberId Int
  matchKitPlayerId Int?

  status       KitAssignmentStatus @default(SUGGESTED)
  pickupStatus KitPickupStatus     @default(PENDING)

  /**
   * Person who actually took the kit.
   * These can differ from the originally
   * assigned player.
   */
  actualRotationMemberId Int?
  actualMatchKitPlayerId Int?
  actualDisplayName      String?

  pickupRecordedAt   DateTime?
  pickupRecordedById String?

  assignedAt  DateTime  @default(now())
  confirmedAt DateTime?
  declinedAt  DateTime?
  completedAt DateTime?
  missedAt    DateTime?
  cancelledAt DateTime?

  assignedById String?

  assignmentReason String?
  responseNote     String?
  ownerNote        String?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  leagueKit LeagueKit? @relation(fields: [leagueKitId], references: [id], onDelete: SetNull)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  /**
   * Originally assigned rotation member.
   * rotationMember KitRotationMember @relation(fields: [rotationMemberId], references: [id], onDelete: Restrict)
   */

  rotationMember KitRotationMember @relation("AssignedKitRotationMember", fields: [rotationMemberId], references: [id], onDelete: Restrict)

  /**
   * Rotation member who actually took
   * the kit.
   */
  actualRotationMember KitRotationMember? @relation("ActualKitCarrier", fields: [actualRotationMemberId], references: [id], onDelete: SetNull)

  /**
   * Originally assigned match player.
   */
  matchKitPlayer MatchKitPlayer? @relation("AssignedKitMatchPlayer", fields: [matchKitPlayerId], references: [id], onDelete: SetNull)

  /**
   * Match player who actually took
   * the kit.
   */
  actualMatchKitPlayer MatchKitPlayer? @relation("ActualKitCarrierPlayer", fields: [actualMatchKitPlayerId], references: [id], onDelete: SetNull)

  assignedBy User? @relation("KitAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  pickupRecordedBy User? @relation("KitAssignmentPickupRecordedBy", fields: [pickupRecordedById], references: [id], onDelete: SetNull)

  reminderLogs    KitReminderLog[]
  leagueKitEvents LeagueKitEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, teamId])
  @@index([leagueKitId, matchId, status])
  @@index([leagueId, teamId, status])
  @@index([rotationMemberId, status])
  @@index([actualRotationMemberId, pickupStatus])
  @@index([matchKitPlayerId])
  @@index([actualMatchKitPlayerId])
}

model KitReminderLog {
  id Int @id @default(autoincrement())

  assignmentId Int
  leagueId     Int?
  matchId      Int?
  teamId       Int?

  recipientType  KitReminderRecipientType
  recipientName  String?
  recipientPhone String?

  reminderType KitReminderType
  channel      KitReminderChannel @default(WHATSAPP)
  status       KitReminderStatus  @default(PENDING)

  providerMessageId String?
  providerStatus    String?
  errorMessage      String?
  providerResponse  Json?

  fallbackSmsAllowed Boolean @default(false)

  fallbackSmsBody String?

  fallbackSmsStatus String?

  fallbackSmsMessageId String?

  fallbackSmsAttemptedAt DateTime?

  fallbackSmsQueuedAt DateTime?

  fallbackSmsError String?

  scheduledFor        DateTime
  processingStartedAt DateTime?
  sentAt              DateTime?
  failedAt            DateTime?

  attemptCount Int @default(0)

  assignment KitAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  league League? @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  match  Match?  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, reminderType, channel, recipientType])
  @@index([status, scheduledFor])
}

model TeamKitState {
  id                    Int     @id @default(autoincrement())
  leagueId              Int
  scopeKey              String
  teamId                Int?
  currentHolderPlayerId Int?
  currentHolderName     String?
  lastMatchId           Int?
  recordedByUserId      String?

  // One mutable/live suggestion per league/team scope.
  // Re-suggesting overwrites these columns.
  suggestedHolderPlayerId Int?
  suggestedHolderName     String?
  suggestedForMatchId     Int?
  suggestedAt             DateTime? @db.Timestamp(3)
  suggestedByUserId       String?
  suggestionNote          String?

  updatedAt DateTime @default(now()) @db.Timestamp(3)

  @@unique([leagueId, scopeKey], map: "TeamKitState_league_scope_key")
  @@index([leagueId])
  @@index([teamId])
  @@index([suggestedForMatchId])
}

model TeamKitCustodyTask {
  id               Int       @id @default(autoincrement())
  leagueId         Int
  scopeKey         String
  teamId           Int?
  matchId          Int
  status           String    @default("PENDING")
  createdAt        DateTime  @default(now()) @db.Timestamp(3)
  resolvedAt       DateTime? @db.Timestamp(3)
  resolvedByUserId String?

  @@unique([matchId, scopeKey], map: "TeamKitCustodyTask_match_scope_key")
  @@index([leagueId, status])
  @@index([teamId])
}

model TeamKitCustodyEvent {
  id                 Int      @id @default(autoincrement())
  leagueId           Int
  scopeKey           String
  teamId             Int?
  matchId            Int?
  holderPlayerId     Int?
  holderName         String?
  previousHolderName String?
  action             String   @default("RECORDED")
  note               String?
  recordedByUserId   String?
  createdAt          DateTime @default(now()) @db.Timestamp(3)

  @@index([leagueId, createdAt])
  @@index([teamId, createdAt])
}

model TeamKitUserAccess {
  id        Int      @id @default(autoincrement())
  leagueId  Int
  userId    String
  teamId    Int
  canView   Boolean  @default(true)
  canRecord Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @default(now()) @db.Timestamp(3)

  @@unique([leagueId, userId, teamId], map: "TeamKitUserAccess_user_team_key")
  @@index([leagueId, userId])
}

model LeagueResource {
  id               Int     @id @default(autoincrement())
  leagueId         Int
  createdById      String
  title            String
  description      String?
  category         String  @default("OTHER")
  resourceType     String  @default("LINK")
  visibility       String  @default("LEAGUE")
  externalUrl      String?
  blobUrl          String?
  blobPathname     String?
  originalFileName String?
  contentType      String?
  fileSize         Int?

  // Search/indexing fields used by the Knowledge Center.
  extractedText   String?
  searchText      String?
  searchStatus    String    @default("PENDING")
  searchError     String?
  searchIndexedAt DateTime?

  isPinned  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league          League                         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdBy       User                           @relation(fields: [createdById], references: [id])
  reactions       LeagueResourceReaction[]
  favorites       LeagueResourceFavorite[]
  collectionItems LeagueResourceCollectionItem[]

  @@index([leagueId, category])
  @@index([leagueId, isPinned, sortOrder])
  @@index([createdById])
}

model LeagueResourceReaction {
  id         Int      @id @default(autoincrement())
  resourceId Int
  userId     String
  reaction   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource LeagueResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@index([resourceId, reaction])
  @@index([userId])
}

model LeagueResourceFavorite {
  id         Int      @id @default(autoincrement())
  resourceId Int
  userId     String
  createdAt  DateTime @default(now())

  resource LeagueResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@index([userId, createdAt])
  @@index([resourceId])
}

model LeagueResourceCollection {
  id          Int      @id @default(autoincrement())
  leagueId    Int
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  league League                         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  LeagueResourceCollectionItem[]

  @@unique([leagueId, userId, name])
  @@index([leagueId, userId, updatedAt])
}

model LeagueResourceCollectionItem {
  id           Int      @id @default(autoincrement())
  collectionId Int
  resourceId   Int
  createdAt    DateTime @default(now())

  collection LeagueResourceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  resource   LeagueResource           @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([collectionId, resourceId])
  @@index([resourceId])
}

model MatchDayManualStatus {
  id                   Int      @id @default(autoincrement())
  leagueId             Int
  matchId              Int      @unique
  availabilityComplete Boolean  @default(false)
  availabilityNote     String?
  completedByUserId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([leagueId, updatedAt])
  @@index([completedByUserId])
}

model PlayerMilestone {
  id                     Int      @id @default(autoincrement())
  leagueId               Int
  matchId                Int?
  ballId                 Int?
  representativePlayerId Int
  identityKey            String
  playerName             String
  playerIds              Int[]
  milestoneType          String
  milestoneValue         Int
  title                  String
  description            String?
  icon                   String   @default("🏆")
  achievedAt             DateTime @default(now())
  isActive               Boolean  @default(true)
  dedupeKey              String   @unique
  metadata               Json?

  @@index([leagueId, identityKey, isActive, achievedAt])
  @@index([matchId])
  @@index([representativePlayerId])
}

model GrowthEvent {
  id        BigInt   @id @default(autoincrement())
  eventType String
  visitorId String?
  sessionId String?
  userId    String?
  leagueId  Int?
  matchId   Int?
  source    String?
  path      String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
  @@index([leagueId, createdAt])
  @@index([matchId, createdAt])
}
