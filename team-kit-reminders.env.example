# Enable the Team Kit reminder endpoint.
TEAM_KIT_REMINDERS_ENABLED=true

# Use a long random value. Put this same value in cron-job.org's
# Authorization header as: Bearer <value>
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# App/time-zone settings.
NEXT_PUBLIC_APP_URL=https://cric4all.app
TEAM_KIT_TIME_ZONE=America/Phoenix

# Twilio.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+...

# Approved WhatsApp Utility templates.
TWILIO_KIT_DAY_BEFORE_CONTENT_SID=HX...
TWILIO_KIT_TWO_HOURS_CONTENT_SID=HX...
TWILIO_KIT_POST_MATCH_CONTENT_SID=HX...
TWILIO_KIT_OVERDUE_CONTENT_SID=HX...
